{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "jsx": "preserve",
    "incremental": true, "noEmit": true, "isolatedModules": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
