# ---------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------
# LOCAL (docker compose): as duas apontam para o mesmo Postgres.
DATABASE_URL="postgresql://obra:obra@localhost:5432/obra_manager?schema=public"
DIRECT_URL="postgresql://obra:obra@localhost:5432/obra_manager?schema=public"

# PRODUÇÃO (Neon): são DUAS strings diferentes.
#   DATABASE_URL -> a agrupada, host COM "-pooler". Usada em tempo de execução.
#   DIRECT_URL   -> a direta, host SEM "-pooler". Usada pelas migrations.
# DATABASE_URL="postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Em produção: a URL pública exata, com https e sem barra no final.
NEXTAUTH_SECRET="troque-por-um-segredo-longo"   # openssl rand -base64 32

# ---------------------------------------------------------------------
# Chaves de criptografia — 32 bytes em hex (64 caracteres)
# Gere cada uma com: openssl rand -hex 32
#
# ATENÇÃO: são irrecuperáveis.
#   ENCRYPTION_KEY perdida  -> todo CPF e dado bancário no banco vira lixo.
#   HASH_KEY trocada        -> a busca por CPF não acha mais os registros
#                              antigos (o hash de busca muda).
# Guarde as duas num cofre antes do primeiro deploy.
# ---------------------------------------------------------------------
ENCRYPTION_KEY=""
HASH_KEY=""

# ---------------------------------------------------------------------
# Bootstrap de produção (só para rodar `npm run db:bootstrap` uma vez)
# ---------------------------------------------------------------------
EMPRESA_NOME=""
EMPRESA_CNPJ=""
ADMIN_NOME=""
ADMIN_EMAIL=""
ADMIN_SENHA=""

# ---------------------------------------------------------------------
# Assistente do projeto (opcional)
#
# Sem estas variáveis o sistema continua inteiro: o resumo executivo é
# gerado a partir dos números, sem modelo de linguagem. O que elas ligam
# é só a conversa livre.
# ---------------------------------------------------------------------
ASSISTENTE_API_KEY=""
# Opcionais, para apontar a outro provedor compatível:
# ASSISTENTE_URL="https://api.openai.com/v1/chat/completions"
# ASSISTENTE_MODELO="gpt-4o-mini"
